# Copy nothing by hand: run `npm run wallets:generate` to create .env with fresh testnet wallets.
# Then add the settings below to .env as needed.

# Optional: your own Base Sepolia RPC (defaults to https://sepolia.base.org)
# BASE_SEPOLIA_RPC_URL=

# Phase 4: Claude API key for the agent
# ANTHROPIC_API_KEY=

# Wallet variables written by the generator (one pair per role):
# TREASURY_PRIVATE_KEY=0x...
# TREASURY_ADDRESS=0x...
# MERCHANT_OFFICE_SUITE_PRIVATE_KEY=0x...   (and _ADDRESS) …etc.
